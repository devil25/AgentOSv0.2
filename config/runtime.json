{
  "version": "0.2.0-rc1",
  "workspace_only": true,
  "max_file_read_bytes": 1048576,
  "max_file_write_chars": 200000,
  "max_tool_steps_per_task": 8,
  "terminal_enabled": false,
  "autonomous_mode": "hybrid",
  "ai_source": "web",
  "default_provider": "zai",
  "require_confirmation_for": [
    "workspace.create_file",
    "mcp.call",
    "plugins.call",
    "browser.open_url",
    "browser.submit_prompt"
  ],
  "text_only_tasks": "answer_without_tools",
  "file_creation": "only_when_explicitly_requested"
}
