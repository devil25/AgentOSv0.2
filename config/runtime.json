{
  "version": "0.2.0-rc1",
  "workspace_only": true,
  "max_file_read_bytes": 1048576,
  "max_file_write_chars": 200000,
  "max_tool_steps_per_task": 40,
  "terminal_enabled": true,
  "autonomous_mode": "autonomous_or_supervised",
  "ai_source": "web",
  "default_provider": "zai",
  "require_confirmation_for": [
    "all_actions_in_supervised_mode",
    "operations_outside_workspace",
    "destructive_system_operations",
    "external_data_transfer",
    "credential_or_security_changes"
  ],
  "text_only_tasks": "answer_without_tools",
  "file_creation": "only_when_explicitly_requested",
  "execution_working_directory": "workspace",
  "terminal_timeout_seconds": 120
}
